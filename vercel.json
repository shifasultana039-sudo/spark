{
  "version": 2,
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://spark-lbi8.onrender.com/api/$1"
    },
    {
      "source": "/blockchain/(.*)",
      "destination": "https://spark-lbi8.onrender.com/blockchain/$1"
    },
    {
      "source": "/health",
      "destination": "https://spark-lbi8.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
