{
  "name": "ReliefChain AI (SPARK)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": {
      "label": "ReliefChain Web App & API",
      "onAutoForward": "openBrowser"
    },
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt && cd frontend && npm install && npm run build",
  "postStartCommand": "cd backend && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 &"
}
