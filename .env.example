# ==============================================================================
# RELIEFCHAIN AI - Environment Configuration Guide
# ==============================================================================
# Copy this file to .env (or backend/.env) to customize your local configuration.
# The application works out of the box with SQLite and simulated testnet fallbacks.

# --- Backend Server & Database Configuration ---
# Port for the FastAPI application server
PORT=8000

# Database Connection (PostgreSQL or SQLite):
# Option A: SQLite (Default for zero-dependency local operation)
DATABASE_URL=sqlite:///./reliefchain.db

# Option B: PostgreSQL (Production / Cloud Deployment)
# Set DATABASE_URL directly:
# DATABASE_URL=postgresql://relief_admin:YOUR_PASSWORD@localhost:5432/reliefchain
# OR configure individual variables (never commit real passwords to git!):
# POSTGRES_USER=relief_admin
# POSTGRES_PASSWORD=YOUR_SECURE_PASSWORD
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=reliefchain

# Directory for uploaded evidence files, photographs, and documents
STORAGE_PATH=./storage/uploads



# --- MST Blockchain Testnet Configuration ---
# Public RPC endpoint for MST Blockchain Testnet
MST_RPC_URL=https://testnetrpc.mstblockchain.com

# Chain ID for MST Testnet (Default: 88888)
MST_CHAIN_ID=88888

# Deployed ReliefChainAudit smart contract address on MST Testnet
MST_CONTRACT_ADDRESS=0x84AB4dC72536D55aDa9617b673dd33AC9d709d14

# Optional: Private key for submitting live transactions (keep secret!)
MST_PRIVATE_KEY=YOUR_MST_PRIVATE_KEY_HERE

# Block explorer URL for inspecting anchored decision transactions
MST_EXPLORER_URL=https://mstscan.com

# Testnet faucet URL for acquiring gas tokens
MST_FAUCET_URL=https://faucet.masterstroke.academy


# --- AI / Computer Vision Configuration ---
# Provider for damage comparison (Default: DEMO_CV_MODEL for local standalone testing)
AI_CV_PROVIDER=DEMO_CV_MODEL


# --- Frontend Configuration ---
# Backend API URL (used by Vite proxy in development or direct client calls in production)
VITE_API_URL=http://127.0.0.1:8000
